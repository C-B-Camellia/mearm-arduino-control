diff --git a/src/pin_uart.cpp b/src/pin_uart.cpp
new file mode 100644
index 0000000..84a205d
--- /dev/null
+++ b/src/pin_uart.cpp
@@ -0,0 +1,51 @@
+#include "pin_uart.h"
+#if defined(__AVR__) && defined(MEARM_NANO_LINK)
+#include <Arduino.h>
+#include <avr/interrupt.h>
+static_assert(F_CPU==16000000UL && MEARM_BUTTON_RX==10,"RX requires Uno D10/PB2 at 16 MHz");
+static_assert(MEARM_BUTTON_BAUD==9600,"sampled UART supports 9600 baud only");
+// Timer0: millis; Timer1: Servo; Timer2: 9600-baud RX sampling only.
+// D10/PB2 is PCINT2 in the PCINT0 group, not the PCINT2 vector.
+namespace {
+volatile uint8_t bytes[16],head=0,tail=0,shift=0,bit=0;
+volatile bool overflow=false;
+}
+ISR(PCINT0_vect) {
+    // Pin-change interrupts fire on both edges; only LOW starts reception.
+    if(PINB&_BV(PB2)) return;
+    PCMSK0&=~_BV(PCINT2); // Mask D10 while data bits are sampled.
+    shift=bit=0; TCNT2=0; OCR2A=77; // First sample: 156 us (1.5 bits).
+    TIFR2=_BV(OCF2A); TIMSK2|=_BV(OCIE2A);
+}
+ISR(TIMER2_COMPA_vect) {
+    if(bit<8) {
+        shift=(shift>>1) | ((PINB&_BV(PB2))?0x80:0);
+        ++bit; OCR2A=51; // Subsequent samples: 104 us.
+    } else {
+        if(PINB&_BV(PB2)) {
+            uint8_t next=(head+1)&15;
+            if(next!=tail) { bytes[head]=shift; head=next; } else overflow=true;
+        } else overflow=true; // Invalid stop bit; discard and require HELLO.
+        TIMSK2&=~_BV(OCIE2A);
+        PCIFR=_BV(PCIF0); PCMSK0|=_BV(PCINT2);
+    }
+}
+void initializePinUart() {
+    pinMode(10,INPUT_PULLUP);
+    uint8_t saved=SREG; cli();
+    head=tail=0; overflow=false;
+    TCCR2A=_BV(WGM21); TCCR2B=_BV(CS21)|_BV(CS20); TIMSK2=0;
+    PCIFR=_BV(PCIF0); PCMSK0|=_BV(PCINT2); PCICR|=_BV(PCIE0);
+    SREG=saved;
+}
+int readPinUart() {
+    if(head==tail) return -1;
+    uint8_t value=bytes[tail]; tail=(tail+1)&15; return value;
+}
+bool pinUartOverflow() {
+    uint8_t saved=SREG; cli();
+    bool value=overflow; overflow=false;
+    if(value) tail=head; // Never parse pre-error queued frames as a new session.
+    SREG=saved; return value;
+}
+#endif
diff --git a/test/nano_link/pin_uart_tests.cpp b/test/nano_link/pin_uart_tests.cpp
new file mode 100644
index 0000000..ed8f060
--- /dev/null
+++ b/test/nano_link/pin_uart_tests.cpp
@@ -0,0 +1,40 @@
+#include <Arduino.h>
+#include <iostream>
+#include <cstdlib>
+volatile uint8_t PINB=0,PCMSK0=0,PCICR=0,PCIFR=0,TCNT2=0,OCR2A=0,TIFR2=0,TIMSK2=0,TCCR2A=0,TCCR2B=0,SREG=0;
+uint8_t configuredPin=255,configuredMode=0;
+#include "../../src/pin_uart.cpp"
+namespace {
+unsigned checks=0;
+void check(bool ok,int line) { ++checks; if(!ok) { std::cerr<<"FAIL UART "<<line<<"\n"; std::exit(1); } }
+#define CHECK(x) check((x),__LINE__)
+void receive(uint8_t value,bool stop=true) {
+    PINB=0; PCINT0_vect();
+    CHECK(!(PCMSK0&_BV(PCINT2)) && (TIMSK2&_BV(OCIE2A)) && OCR2A==77);
+    for(uint8_t i=0;i<8;++i) {
+        PINB=(value&(1<<i))?_BV(PB2):0;
+        TIMER2_COMPA_vect();
+        CHECK(OCR2A==51 && (TIMSK2&_BV(OCIE2A)));
+    }
+    PINB=stop?_BV(PB2):0; TIMER2_COMPA_vect();
+    CHECK((PCMSK0&_BV(PCINT2)) && !(TIMSK2&_BV(OCIE2A)));
+}
+}
+int main() {
+    SREG=0x80; PCMSK0=0x80; PCICR=0x04;
+    initializePinUart();
+    CHECK(configuredPin==10 && configuredMode==INPUT_PULLUP && SREG==0x80);
+    CHECK(PCMSK0==0x84 && PCICR==0x05 && PCIFR==_BV(PCIF0));
+    CHECK(TCCR2A==_BV(WGM21) && TCCR2B==(_BV(CS21)|_BV(CS20)));
+    CHECK(readPinUart()==-1 && !pinUartOverflow());
+    // HIGH/rising edges and other PB changes while RX HIGH do not start a byte.
+    PINB=_BV(PB2)|1; PCINT0_vect(); CHECK(TIMSK2==0 && PCMSK0==0x84);
+    for(unsigned i=0;i<256;++i) { receive(i); CHECK(readPinUart()==int(i)); CHECK(readPinUart()==-1); }
+    receive(0xA5,false); CHECK(pinUartOverflow() && readPinUart()==-1 && !pinUartOverflow());
+    for(uint8_t i=0;i<15;++i) receive(i);
+    receive(99); CHECK(pinUartOverflow()); CHECK(readPinUart()==-1); // Flush stale queue.
+    receive(0x5A); CHECK(readPinUart()==0x5A && !pinUartOverflow());
+    receive(1); initializePinUart(); CHECK(readPinUart()==-1);
+    SREG=0; CHECK(!pinUartOverflow() && SREG==0); // Preserve caller interrupt state.
+    std::cout<<"PASS D10 UART register model: "<<checks<<" checks\n";
+}
